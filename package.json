{
  "name": "kyypurestatus",
  "version": "1.0.0",
  "private": true,
  "description": "KyyPureStatus \u2014 kompresi video HD cerdas di server, auto kirim ke WhatsApp biar story lu tetep tajem. Built with love by KyyDevv.",
  "author": "KyyDevv",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "server:dev": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently -n SERVER,CLIENT -c magenta,cyan \"npm:server\" \"npm:client\"",
    "build": "npm run client:build",
    "install:all": "npm install && npm --prefix client install",
    "postinstall": "node scripts/postinstall.js",
    "clean": "node -e \"const fs=require('fs');['data/uploads','data/output','data/tmp'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});fs.mkdirSync(d,{recursive:true});console.log('cleared '+d)}catch(e){console.error(e.message)}})\"",
    "smoke": "node scripts/smoke.js",
    "integration": "node scripts/integration.js",
    "test:render": "npm --prefix client run test:render",
    "test": "npm run smoke && npm run integration && npm run test:render"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^1.4.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "concurrently": "^8.2.2",
    "socket.io-client": "^4.8.3"
  }
}
