# ===================================================================
# KyyPureStatus — Environment Configuration
# Copy jadi .env terus sesuaikan. Semua punya default aman, jadi boleh kosong.
# ===================================================================

# --- Server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# --- Mode Uji ---
# true  = skip Baileys, langsung emit sukses setelah kompresi (buat ngetes UI/UX)
# false = beneran kirim lewat WhatsApp
MOCK_SEND=false

# --- Path Storage (default: ./data) ---
DATA_DIR=./data
SESSION_DIR=./data/sessions
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/output
THUMB_DIR=./data/thumbs

# --- Upload & Size Limit ---
MAX_UPLOAD_MB=100
WA_MEDIA_LIMIT_MB=50
# Auto cleanup tiap 10 menit (ms)
CLEANUP_INTERVAL_MS=600000
# Umur file sebelum disapu (menit)
UPLOAD_TTL_MIN=120
OUTPUT_TTL_MIN=240
# History maksimal 8 entri
HISTORY_LIMIT=8

# --- FFmpeg ---
# Kosongin kalo ffmpeg/ffprobe udah ada di PATH (Docker install ffmpeg via apt)
FFMPEG_PATH=
FFPROBE_PATH=
# Jumlah maksimum job encode barengan (1 = single-flight ketat)
MAX_CONCURRENT_JOBS=1

# --- WhatsApp ---
# Nama device yang muncul di "Perangkat Tertaut"
WA_DEVICE_NAME=KyyPureStatus
# Auto reconnect: 2s -> 30s
WA_RECONNECT_MIN_MS=2000
WA_RECONNECT_MAX_MS=30000

# --- Security (opsional) ---
# Kalo diisi, client harus kirim header X-Kyy-Token yang sama buat akses API
API_TOKEN=
# Asal CORS yang diijinkan (pisahkan koma). Default * 
CORS_ORIGIN=*
